# Copy to .env — never commit a real .env with keys in it.
# Server
PORT=3000
# The owner account name. Owner is ONLY an exact name match with this
# value (default Lucas, case-insensitive) — the first account created is
# NOT the owner just for being first.
OWNER_NAME=Lucas
# Owner claim code (H4): required to register-with-PIN or claim the owner
# account. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave it empty and owner claims are refused outright (fail closed).
# Never commit a real code — set it in the host's environment instead.
OWNER_CLAIM_CODE=

# AI (optional) — for Predictor + AUTO AI mode. Without this, AI mode falls
# back to rules with a clear note. OpenAI-compatible endpoint:
#   AI_API_URL=https://api.openai.com/v1/chat/completions
#   AI_API_KEY=sk-...
# Azure OpenAI (do this later, as Lucas planned):
#   AI_API_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01
#   AI_API_KEY=<your Azure key>
#   AI_MODEL=gpt-4o-mini
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Discord community server invite (optional) — shown as a "Join our
# Discord" button on the welcome screen and in the menu. Leave blank
# until the server has a real invite link; while blank the button reads
# "Discord — coming soon" and links nowhere.
#   DISCORD_INVITE_URL=https://discord.gg/xxxxxx
DISCORD_INVITE_URL=

# Email (optional) — SMTP for ping / auto-trade emails. Without this, emails
# are queued in the database and logged, and the Test Email button reports
# "SMTP not configured" instead of silently pretending it sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
